{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Neima in Google Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000/index.html",
            "webRoot": "${workspaceFolder}",
            "runtimeArgs": [
                "--load-extension=${workspaceFolder}"
            ]
        },
        {
            "name": "Launch Showcase (Local File)",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "name": "Start Local Preview Server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/server.js",
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Neima in Microsoft Edge",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:3000/index.html",
            "webRoot": "${workspaceFolder}",
            "runtimeArgs": [
                "--load-extension=${workspaceFolder}"
            ]
        }
    ]
}